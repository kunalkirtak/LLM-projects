# Google AI Studio API key (Gemini free tier)
# Create one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Default model used when the UI does not override it
DEFAULT_MODEL=gemini-1.5-flash

# SQLite database location (relative to project root)
DATABASE_URL=sqlite:///results/evaluations.db

# Set to "true" to force cost estimation to $0.00 (Gemini free tier)
FREE_TIER_MODE=true
