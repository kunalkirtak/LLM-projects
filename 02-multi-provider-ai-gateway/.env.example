# ---------------------------------------------------------------------------
# Multi-Provider AI Gateway — environment configuration
# Copy this file to .env and fill in the keys for the providers you want to use.
# You do NOT need all three: the gateway works fine with just one configured
# provider (fallback simply skips providers that aren't configured).
# ---------------------------------------------------------------------------

# --- Provider credentials ---------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Default models per provider --------------------------------------------
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
GEMINI_DEFAULT_MODEL=gemini-flash-latest

# --- Gateway routing behavior ------------------------------------------------
DEFAULT_PROVIDER=openai
FALLBACK_ORDER=openai,anthropic,gemini
ENABLE_FALLBACK=true

# --- Retry / resilience -------------------------------------------------
MAX_RETRIES=3
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=10.0
REQUEST_TIMEOUT_SECONDS=60.0

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/requests.log
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
